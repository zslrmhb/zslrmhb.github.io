@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
}

@layer components {
  /* Enhanced Markdown Styles */
  .markdown h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    scroll-margin-top: 4rem;
  }

  .markdown h2 {
    font-size: 1.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    margin-top: 2rem;
    scroll-margin-top: 4rem;
  }

  .markdown h3 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 1rem;
    margin-top: 1.5rem;
    scroll-margin-top: 4rem;
  }

  .markdown h4 {
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1rem;
    margin-top: 1.25rem;
    scroll-margin-top: 4rem;
  }

  .markdown h5 {
    font-size: 1rem;
    font-weight: 400;
    margin-bottom: 1rem;
    margin-top: 1rem;
    scroll-margin-top: 4rem;
  }

  .markdown h6 {
    font-size: 0.875rem;
    font-weight: 400;
    margin-bottom: 1rem;
    margin-top: 0.75rem;
    scroll-margin-top: 4rem;
  }
  
  .markdown p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }
  
  .markdown a {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }
  
  .markdown a:hover {
    text-decoration-color: hsl(var(--primary) / 0.5);
  }
  
  .markdown blockquote {
    border-left: 4px solid hsl(var(--primary));
    padding-left: 1rem;
    font-style: italic;
    margin: 1.5rem 0;
    color: hsl(var(--muted-foreground));
  }
  
  .markdown code {
    background-color: hsl(var(--muted));
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace;
  }
  
  .markdown pre {
    background-color: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  
  .markdown pre code {
    background-color: transparent;
    padding: 0;
  }
  
  .markdown ul, .markdown ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  
  .markdown li {
    margin-bottom: 0.25rem;
  }
  
  .markdown table {
    border-collapse: collapse;
    border: 1px solid hsl(var(--border));
    margin: 1.5rem 0;
    width: 100%;
  }
  
  .markdown th {
    border: 1px solid hsl(var(--border));
    background-color: hsl(var(--muted));
    padding: 0.5rem 1rem;
    text-align: left;
    font-weight: 600;
  }
  
  .markdown td {
    border: 1px solid hsl(var(--border));
    padding: 0.5rem 1rem;
  }
  
  .markdown img {
    border-radius: 0.5rem;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    margin: 1.5rem auto;
  }
  
  .markdown hr {
    border-top: 1px solid hsl(var(--border));
    margin: 2rem 0;
  }
  
  .markdown strong {
    font-weight: 600;
  }
  
  .markdown em {
    font-style: italic;
  }
}

/* Custom scrollbar for TOC */
@layer utilities {
  .toc-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground)) hsl(var(--background));
  }
  
  .toc-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  
  .toc-scrollbar::-webkit-scrollbar-track {
    background: hsl(var(--background));
  }
  
  .toc-scrollbar::-webkit-scrollbar-thumb {
    background: hsl(var(--muted-foreground));
    border-radius: 3px;
  }
  
  .toc-scrollbar::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--foreground));
  }
}
